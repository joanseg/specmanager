# server/dist/ AND ui/dist/ are committed — plugin consumers install straight
# from GitHub and need both the compiled MCP server (server/dist/mcp.js) and
# the built kanban UI (ui/dist/index.html). Contributors run:
#   cd plugins/specmanager        && npm ci
#   cd plugins/specmanager/server && npm ci && npm run build
#   cd plugins/specmanager/ui     && npm ci && npm run build
# before committing source changes.

# Local Claude settings must never be committed, least of all into the plugin
# folder that ships.
